# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# uploads
public/uploads/

# prisma sqlite
*.db
*.db-journal
prisma/dev.db
prisma/dev.db-journal

# GeoNames gazetteer import scratch dir (scripts/dev/import-places.mjs deletes
# this itself when it finishes; ignored as a backstop)
.geonames-tmp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# The uncompressed source for the landing hero. Kept locally to re-export from;
# only the optimised landing.jpeg is committed.
public/images/landing-original.jpeg

# screenshots
temporary screenshots/

# A build cache moved aside by hand when Turbopack corrupts it (see CLAUDE.md).
.next-stale/

# Agent tooling. All of it is generated by an installer and reinstallable, so
# none of it is committed. .planning/, .codex/ and .agents/ were deleted on
# 2026-08-07 (a GSD scaffold abandoned the week it was made); these lines stay
# as a backstop in case the installer ever writes them again.
.claude/
.planning/
.codex/
.agents/

# Local reference material and credentials (not part of the app)
sanan's stuff/
recovery-codes.txt

# Demo photo inbox: originals live here, only the generated webp in public/ is committed
demo-photos/

# Demo database password, written by the demo setup. Never committed.
.demo-db-password

# One-off debugging probes. Throwaway by nature, never referenced by the app.
.scratch/

# Supabase CLI local link state, written by `supabase link`. Machine-specific.
supabase/.temp/

# Playwright. Baselines in e2e/__screenshots__ ARE committed (they are the
# picture memory); everything below is per-run output or a live credential.
/test-results/
/playwright-report/
/blob-report/
/e2e/.auth/
