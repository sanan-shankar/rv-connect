# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# uploads
public/uploads/

# GeoNames gazetteer import scratch dir (scripts/dev/import-places.mjs deletes
# this itself when it finishes; ignored as a backstop)
.geonames-tmp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# The uncompressed source for the landing hero. Kept locally to re-export from;
# only the optimised landing.jpeg is committed.
public/images/landing-original.jpeg

# screenshots
temporary screenshots/

# A build cache moved aside by hand when Turbopack corrupts it (see CLAUDE.md).
# Trailing wildcard: the move is by convention `mv .next .next-stale-$(date
# +%s)`, so a bare `.next-stale/` here missed every timestamped one and let
# 10k+ untracked cache files leak into git status (owner, 2026-08-22).
.next-stale*/

# Agent tooling. MOST of it is generated by an installer and reinstallable, so
# most of it is not committed. .planning/, .codex/ and .agents/ were deleted on
# 2026-08-07 (a GSD scaffold abandoned the week it was made); these lines stay
# as a backstop in case the installer ever writes them again.
#
# Two exceptions, un-ignored 2026-08-19. .claude/skills/ was ALREADY tracked
# (40 files -- gitignore never applied to them, since it cannot touch files
# git already knows about), so the skills were safe all along. The agents were
# not: design-protocol-auditor, screenshot-qa and write-path-reviewer were
# written for this repo, encode the design system and the write-path
# invariants, are named in CLAUDE.md by path, and existed in exactly one place
# on one machine. One `rm -rf .claude` and they were gone.
#
# settings.local.json stays ignored by .claude/* below -- it holds local
# permission grants, not shared work.
.claude/*
!.claude/agents/
!.claude/skills/
.planning/
.codex/
.agents/

# Local reference material and credentials (not part of the app)
sanan's stuff/
recovery-codes.txt

# Demo photo inbox: originals live here, only the generated webp in public/ is committed
demo-photos/

# Demo database password, written by the demo setup. Never committed.
.demo-db-password

# One-off debugging probes. Throwaway by nature, never referenced by the app.
.scratch/

# Pre-migration snapshots. A DROP is irreversible and Supabase's free plan has
# no point-in-time recovery, so every destructive migration writes the rows it
# is about to destroy here first. Never tracked: these hold real member data
# (Visit coordinates, among others), which is the whole reason they exist and
# the whole reason they must not enter git.
.backups/

# Supabase CLI local link state, written by `supabase link`. Machine-specific.
supabase/.temp/

# Playwright. Baselines in e2e/__screenshots__ ARE committed (they are the
# picture memory); everything below is per-run output or a live credential.
/e2e/.output/
/e2e/.report/
/e2e/.auth/
.tmp-shots/

# Local WebKit build for reproducing Safari-only bugs (not committed, ~100MB)
.pw-browsers/

# Output of the Apple edge-light harness (scripts/dev/apple-edge/). The tools
# and the write-up are committed; their comparison strips are a few hundred KB
# that any of them regenerates.
scripts/dev/apple-edge/*.png

# The tagging session's working folder (scripts/dev/tag-photos-*.mjs). Holds
# JPEG copies of real members' photographs plus the undo logs for what was
# written back. Regenerated by the picker in seconds; never committed, for the
# same reason .backups/ is not.
.tagging/
