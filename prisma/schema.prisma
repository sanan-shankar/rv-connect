generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String?
  emailVerified DateTime?
  avatarColor   String?
  photoUrl      String?   // uploaded profile photo; overrides the bird avatar everywhere
  bio           String?
  about         String?   // long-form "in their words" paragraph (profile About tab)
  openTo        String?   // retired 2026-07-30 (owner call). Column kept for a future cleanup migration; no reader or writer remains.
  currentCity   String?   // primary city, shown everywhere
  secondaryCity String?   // optional second base, shown on the profile and searchable
  houses        String?   // JSON string of [{year, house}]; canonical house list in src/lib/houses.ts
  displayEmail  String?   // profile may show a different email than the sign-in one
  birdOverride  String?   // manual bird-species slug override (admin assignment + supporter perk)
  birdPickedAt  DateTime? // when the supporter last spent a pick; a paid contribution NEWER than this grants another (see chooseBird)
  workplace     String?
  jobTitle      String?
  phone         String?
  phones        String?   // JSON string of string[] (bare numbers; the first one is mirrored into legacy `phone`)
  instagram     String?
  linkedin      String?
  facebook      String?
  links         String?   // JSON array of {label, url}: user-defined "Other links" rows (Contact section)
  accountType   String    @default("alumnus") // "alumnus" | "teacher" | "ex_teacher"
  batchType     String?   // derived board credential: "ISC" (left in 12), "ICSE" (left in 10/11), null for mid-school leavers and teachers
  batchYear     Int?      // year the person's class would finish 12th (their "Batch of"); derived, not the year they left
  yearJoined    Int?      // calendar year they started (beginning of an academic year)
  yearLeft        Int?    // calendar year they left (end of an academic year)
  gradeJoined   Int?      // grade they were in when they joined; with yearJoined/yearLeft this pins the batch
  admissionNumber Int?
  taughtFrom    Int?      // teacher tenure start
  taughtUntil   Int?      // null = still teaching
  subjects      String?   // comma list, e.g. "Biology, Nature Club"
  role          String    @default("member") // "member" | "admin"
  verifyState   String    @default("unverified") // unverified | pending | verified | flagged
  verifiedAt    DateTime?
  verifyMethod  String?   // office_list | community | admin_manual
  isBlocked     Boolean   @default(false)
  // Bumped whenever this account's credentials or standing change: a password
  // reset or change, a block, an unblock. The value is copied into the JWT at
  // sign-in and compared on every session read, so raising it invalidates every
  // token already in the wild.
  //
  // WHY: sessions are JWTs with no server-side store, so before this there was
  // no way to end one. A phished member could reset their password and the
  // attacker's cookie kept working for its full 30 days (audit M4); blocking
  // somebody removed them from the directory but left them posting (audit H4).
  // The same one column answers both, plus the deleted-account case, which is
  // the only revocation primitive this design can have.
  credentialVersion Int   @default(0)
  adminNote     String?
  theme         String?   // UI theme preference: "light" | "dark"; null = light (the default, so existing rows need no backfill). Mirrored into the rv-theme cookie (src/lib/theme.ts) for SSR.
  // Last time this member loaded an authenticated page, rounded to ~15 minutes
  // (src/lib/last-seen.ts). THE ONE QUESTION THE DATABASE COULD NOT ANSWER:
  // "who is still using this". Impossible to backfill -- there is no history to
  // recover -- so it was added the day the analytics room was built rather than
  // discovered missing afterwards.
  lastSeenAt    DateTime?
  // createdAt of the newest post this member has already been shown in the
  // feed, which is what the "New since you were last here" divider draws
  // against. It lived in localStorage until 2026-08-20, so the divider was
  // per-browser: signing in on a phone and a laptop meant being told the same
  // posts were new twice (owner: "should only appear once, not once on each
  // device"). Only ever moves forward, so the older of two devices catching up
  // cannot rewind it. Null = never seen a feed; the divider stays hidden.
  feedSeenAt    DateTime?
  visits        Visit[]
  searches      SearchLog[]
  contentViews  ContentView[] @relation("ContentViewer")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  posts         Post[]
  comments      Comment[]
  likes         Like[]
  commentLikes  CommentLike[]
  pollVotes     PollVote[]
  reports       Report[]       @relation("ReportsFiled")
  reportsAgainst Report[]      @relation("ReportsAgainst")
  notifications Notification[]
  coverPhoto    String?   // a Collection photo url reused as profile cover
  photoTrusted  Boolean   @default(false) // auto-approve this uploader's future photos

  accounts      Account[]
  sessions      Session[]
  authTokens    AuthToken[]
  outboundMail  OutboundEmail[]
  bookmarks     Bookmark[]
  groupMemberships GroupMember[]
  createdGroups    Group[]
  groupInvitesSent     GroupInvite[] @relation("GroupInvitesSent")
  groupInvitesReceived GroupInvite[] @relation("GroupInvitesReceived")
  photos         Photo[]     @relation("PhotoUploader")
  approvedPhotos Photo[]     @relation("PhotoApprover")
  photoLoves     PhotoLove[]
  places         UserPlace[]

  // Member <-> admins conversations (see AdminThread below).
  adminThreads    AdminThread[]      @relation("AdminThreadMember")
  adminMessages   AdminMessage[]     @relation("AdminMessageAuthor")

  // Catch-ups (the recurring group newsletter). Back-relations for the six Catchup* models.
  catchupsKept    Catchup[]          @relation("CatchupsKept")
  catchupPrompts  CatchupPrompt[]    @relation("CatchupPromptsAuthored")
  catchupEntries  CatchupEntry[]     @relation("CatchupEntriesAuthored")
  catchupLoves    CatchupEntryLove[] @relation("CatchupLoves")
  catchupPrefs    CatchupPref[]      @relation("CatchupPrefs")

  contributions   Contribution[]     @relation("Contributions")
}

model Photo {
  id           String    @id @default(cuid())
  uploaderId   String

  thumbUrl     String    // 480px  — grid
  url          String    // 1600px — detail view, reusable as a post/cover image
  originalUrl  String?   // optional full-size (not generated in MVP)
  blurhash     String?   // optional LQIP (not generated in MVP)
  width        Int
  height       Int

  caption      String?

  // faceted taxonomy (fixed enums validated by Zod; comma-joined where multi).
  // subject/freeTags are no longer collected by the contribute form (2026-07-18
  // rework) but stay on the model for old rows and any other Collection reader.
  subject      String    // e.g. "banyan,landscape"
  area         String?   // free text, "Part of school" (was a fixed picklist)
  era          String    @default("unknown") // decade bucket, derived from photoYear when given
  freeTags     String?   // comma-joined free text, mainly bird/species names

  // "When", as given by the contributor: an exact year (photoYear), an
  // optional month alongside it, or -- when they weren't sure of the exact
  // year -- just the decade fallback stored in `era` above. datePrecision
  // records which of those they actually gave.
  photoYear     Int?
  photoMonth    Int?      // 1-12; only meaningful alongside photoYear
  datePrecision String?   // "month" | "year" | "decade" | "unknown"

  approved     Boolean   @default(false)
  isHidden     Boolean   @default(false)
  approvedAt   DateTime?
  approvedById String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  uploader   User        @relation("PhotoUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  approvedBy User?       @relation("PhotoApprover", fields: [approvedById], references: [id])
  loves      PhotoLove[]

  @@index([approved, isHidden, createdAt])
  @@index([era])
}

model PhotoLove {
  id      String @id @default(cuid())
  userId  String
  photoId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([userId, photoId])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  coverImage  String?  // optional cover photo url (Collection or upload)
  visibility  String   @default("public") // "public" (browseable, auto-join) | "private" (invite-only, hidden)
  creatorId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator  User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members  GroupMember[]
  posts    Post[]
  invites  GroupInvite[]
  catchup  Catchup?

  @@index([visibility, createdAt])
}

model GroupInvite {
  id        String   @id @default(cuid())
  groupId   String
  inviterId String
  inviteeId String
  status    String   @default("pending") // "pending" | "accepted" | "declined"
  createdAt DateTime @default(now())

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter User  @relation("GroupInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User  @relation("GroupInvitesReceived", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([groupId, inviteeId])
  @@index([inviteeId, status])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("member") // "admin" | "member"
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Email tokens: password reset and address confirmation ───────────────────
// One row per link we mail out. NOT NextAuth's VerificationToken above, which
// belongs to the (unused) email provider and stores its token in the clear.
//
// `tokenHash` is a SHA-256 of the random token, and the raw token exists in
// exactly one place: the URL in the person's inbox. So a leaked database
// backup, a stray log line, or a read-only SQL injection cannot be turned into
// an account takeover, which a plaintext reset table hands over outright. The
// hash is the primary lookup key, so verifying a link is one indexed read and
// the raw value is never sent to Postgres at all.
//
// `usedAt` rather than a delete: a consumed row is kept so a second click on
// the same link can say "this link was already used" instead of the identical
// "invalid link" a missing row would produce. Those are different problems for
// the person reading the screen, and telling them apart is most of what makes
// this flow survivable for someone who is not good with computers.
model AuthToken {
  id     String @id @default(cuid())
  userId String
  // "reset" (set a new password) | "verify" (confirm this address is yours).
  // Checked on consume, so a confirmation link can never be replayed as a
  // password reset even if the two ever shared a token space.
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  // The address the link was sent to. Kept so a reset issued before someone
  // changes their email cannot be redeemed afterwards, and so the "we sent it
  // to a****@gmail.com" line can be rebuilt without a second lookup.
  sentTo    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The rate-limit read: "how many of this kind has this user asked for
  // recently". Ordered so the count is an index-only scan.
  @@index([userId, kind, createdAt])
  // The sweep read: expired rows are deleted opportunistically on mint.
  @@index([expiresAt])
}

// ─── The outbound mail queue ─────────────────────────────────────────────────
// Resend's free plan sends 100 messages a day. Launch is expected to put more
// than 100 signups through in the first day (owner, 2026-08-11), so mail is
// NOT sent inline from the action that triggers it. Every message becomes a
// row here and a drain pass sends what the day's budget allows, oldest first
// within priority. The rest wait for tomorrow.
//
// Two decisions in this shape are worth keeping:
//
// 1. The message is stored as its INGREDIENTS (`payload`), not as rendered
//    HTML. A template fix therefore reaches everything still queued, and the
//    table stays small enough to ignore.
// 2. Nothing here holds a token. The AuthToken is minted by the drain, at the
//    moment of sending. A verify link minted at signup and posted two days
//    later would arrive already dead, which is the exact failure a queue
//    introduces if you are not looking for it.
model OutboundEmail {
  id     String  @id @default(cuid())
  userId String?
  to     String
  // "verify" | "reset" | "password-changed". Decides which template renders
  // and which token, if any, gets minted at send time.
  kind String
  // Template inputs as JSON (a name, an address). Never a token, never a
  // password, never anything that would matter if this table leaked.
  payload String?
  // Lower sends first. A password reset is somebody locked out RIGHT NOW; a
  // welcome confirmation can wait a day without anyone being stuck.
  priority Int @default(100)

  status    String    @default("queued") // queued | sending | sent | failed
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())

  // --- Delivery, as the PROVIDER saw it (2026-08-19) -------------------
  // `status` above only ever meant "Resend accepted this from us". It says
  // nothing about whether the mail reached a human. At launch, when a few
  // hundred invitations go out at once, the difference between "400 sent"
  // and "400 delivered" is the difference between a working launch and a
  // silent one. These are written only by the Resend webhook
  // (src/app/api/resend/webhook/route.ts), never by the send path.

  // Resend's own id for the message, captured at send time. The join key: a
  // webhook event carries this and nothing else that identifies the row.
  providerId String?

  deliveredAt DateTime?
  // A hard bounce means the address is dead and retrying is pointless; a
  // soft bounce is a full mailbox or a temporary refusal. Stored raw as
  // Resend reports it rather than collapsed to a boolean, because the two
  // deserve different handling and that decision is not made here.
  bouncedAt   DateTime?
  bounceKind  String?
  // Someone pressed "this is spam". Rare, and the single most damaging
  // signal for a young sending domain, so it is recorded separately.
  complainedAt DateTime?
  // Set while a drain pass owns this row, so two concurrent page views cannot
  // both send it. A row stuck in "sending" past the stale window is reclaimed.
  claimedAt DateTime?
  sentAt    DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The drain read: the next thing to send.
  @@index([status, priority, createdAt])
  // The budget read: how many went out since midnight UTC.
  @@index([sentAt])
  // "Has this person's confirmation actually left yet?", which is what decides
  // whether the app may tell them to go and look in their inbox.
  @@index([userId, kind, status])
  // The webhook read: find the row a provider event belongs to.
  @@index([providerId])
}

model Post {
  id            String    @id @default(cuid())
  authorId      String
  kind          String    @default("post") // "post" | "letter"
  title         String?   // used by letters
  content       String
  tag           String?   // retired 2026-08-02 (owner call: post types abandoned). Column kept for a future cleanup migration; no reader or writer remains.
  targetBatches String?
  images        String?
  groupId       String?   // null = main feed; set = posted into a group
  cityScope     String?   // null = everyone; otherwise the city short-name this post is limited to (admins see all)
  isHidden      Boolean   @default(false)
  status        String    @default("published") // "published" | "draft" — drafts are letters saved before sending; only ever visible to their author
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group       Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  comments    Comment[]
  likes       Like[]
  bookmarks   Bookmark[]
  pollOptions PollOption[]
  pollVotes   PollVote[]
  reports     Report[]

  @@index([groupId, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  postId    String
  parentId  String?
  isHidden  Boolean  @default(false) // admin soft-hide (moderation); matches Post.isHidden / Photo.isHidden
  // Author's own delete. Soft, never a row delete: replies key off parentId,
  // so a hard delete would orphan them (the FK is SetNull, which silently
  // promotes replies to top level) and the thread would lie about its shape.
  // Content is blanked at delete time; the row survives only as structure.
  // Every count and every fetch excludes deleted rows; a deleted parent with
  // surviving replies renders as a "[deleted]" stub.
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent       Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies      Comment[]     @relation("CommentReplies")
  commentLikes CommentLike[]

  @@index([postId, createdAt])
  @@index([postId, isHidden])
}

model Like {
  id     String @id @default(cuid())
  userId String
  postId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Report {
  id             String   @id @default(cuid())
  reason         String
  reporterId     String
  targetType     String   @default("post") // "post" | "user"
  postId         String?
  reportedUserId String?
  status         String   @default("pending") // "pending" | "reviewed" | "dismissed"
  createdAt      DateTime @default(now())

  reporter     User  @relation("ReportsFiled", fields: [reporterId], references: [id])
  post         Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportsAgainst", fields: [reportedUserId], references: [id], onDelete: Cascade)

  // The conversation the reporter can follow after filing this (see AdminThread).
  // Back-relation only: the foreign key lives on AdminThread.reportId.
  thread AdminThread?

  // One report per (reporter, reported member): a member cannot inflate the
  // flag count against someone by reporting them over and over (audit H5).
  // Post reports carry reportedUserId = NULL, and Postgres treats NULLs as
  // distinct in a unique index, so this constrains only user-to-user reports
  // and leaves post reporting unaffected.
  @@unique([reporterId, reportedUserId])
}

/**
 * The audit log (audit H10 / H14 / M36). An append-only record of the events
 * that matter for accountability and breach detection: sign-ins (success and
 * failure), every admin action against a member (block, delete, role change,
 * verification change), a member deleting their own account, and reports.
 *
 * Deliberately has NO foreign keys. actorId and targetId are plain strings, so
 * a row is immutable and OUTLIVES the accounts it names — the entire point of
 * an audit log is that "admin X deleted member Y" survives Y's deletion (and
 * X's). Denormalised context (a name, an email, a method) goes in `detail` for
 * the same reason: it stays readable after the referenced row is gone.
 */
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // who did it; null for an anonymous/system event (e.g. a failed sign-in)
  action     String // dotted verb, e.g. "signin.success", "admin.block", "account.delete"
  targetType String? // "user" | "post" | "report" | ...
  targetId   String?
  ip         String?
  detail     String? // small human-readable context, safe to read after the row it names is gone
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetId])
  @@index([action, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "like" | "comment" | "reply" | "admin" | "admin_note" | "admin_message" | "report_update"
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  // The bell's page walk: newest-first keyset per user. Also what the
  // 100-per-user prune sorts by to find its cutoff.
  @@index([userId, createdAt])
}

// ─── Messages between a member and the admins ────────────────────────────────
// One private conversation per subject, always between exactly one member and
// whichever admin answers. Replaced the third-party Tally feedback form
// (2026-07-24): bug reports, ideas, moderation notes, and the follow-up on
// anything a member reported all land here, so nobody is left wondering what
// happened. Reading or writing a thread is allowed for its own member and for
// admins, and nobody else; every action re-checks that server-side.

model AdminThread {
  id       String  @id @default(cuid())
  memberId String
  // Short line shown in the list. Derived from the first message when the
  // member does not write one, so nothing is ever required of them.
  subject  String?
  // "message" (plain) | "bug" | "idea" | "notice" (an admin started it, e.g. a
  // moderation note) | "report" (follow-up on something the member reported).
  kind     String  @default("message")
  status   String  @default("open") // "open" | "closed"
  // Set when the thread follows a Report the member filed. Unique so one
  // report has at most one conversation. SetNull keeps the conversation alive
  // if the reported post (and with it the report) is deleted.
  reportId String? @unique

  lastMessageAt DateTime @default(now())
  memberUnread  Boolean  @default(false) // unread admin replies waiting for the member
  adminUnread   Boolean  @default(false) // unread member messages waiting for an admin
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member   User           @relation("AdminThreadMember", fields: [memberId], references: [id], onDelete: Cascade)
  report   Report?        @relation(fields: [reportId], references: [id], onDelete: SetNull)
  messages AdminMessage[]

  @@index([memberId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([adminUnread, lastMessageAt])
}

model AdminMessage {
  id       String @id @default(cuid())
  threadId String
  // Null for the lines the app writes itself (e.g. "You reported a post by X"),
  // and for anyone whose account is later deleted.
  authorId String?
  // Which side wrote it. Stored rather than derived from the author's current
  // role, so a member who later becomes an admin does not retro-change history.
  fromAdmin Boolean @default(false)
  body      String
  imageUrl  String? // one optional screenshot (WebP via /api/upload)
  createdAt DateTime @default(now())

  thread AdminThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User?       @relation("AdminMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
}

model PollOption {
  id       String     @id @default(cuid())
  postId   String
  text     String
  position Int

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes PollVote[]
}

model PollVote {
  id           String @id @default(cuid())
  pollOptionId String
  userId       String
  postId       String

  pollOption PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       Post       @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model CommentLike {
  id        String @id @default(cuid())
  userId    String
  commentId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

// ─── Places: GeoNames gazetteer for the robust location picker ──────────────

model Place {
  id         Int    @id // geonameid
  name       String
  asciiName  String
  altNames   String? // comma list, for alt-spelling search
  lat        Float
  lng        Float
  country    String // ISO-3166 alpha-2
  admin1     String? // resolved state/province name
  population Int    @default(0)

  userPlaces UserPlace[]

  // NOTE: in the live DB these two are case-insensitive EXPRESSION indexes
  // (lower("asciiName") / lower(name), text_pattern_ops) that power the
  // directory's case-insensitive city search. Prisma cannot express lower() in
  // a schema, so `migrate diff` / `db push` will ALWAYS want to recreate them as
  // plain column indexes. That is a permanent false positive, not real drift.
  // Do NOT let `db push` "fix" it: replacing the lower() indexes with plain ones
  // silently slows directory search. Apply real index changes by hand instead.
  @@index([asciiName])
  @@index([name])
}

// A person's cities: unlimited, ordered, all shown everywhere. label is the
// full display string; city is the short name used for chips, search, and
// Post.cityScope matching. placeId/lat/lng null = free-typed (gazetteer miss).
model UserPlace {
  id        String   @id @default(cuid())
  userId    String
  placeId   Int?
  label     String
  city      String
  lat       Float?
  lng       Float?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place? @relation(fields: [placeId], references: [id])

  @@index([userId])
  // Case-insensitive expression index in the DB (lower(city)); see the fuller
  // note on Place above. `migrate diff` will always flag it; do not "fix" it.
  @@index([city])
}

// ─── Catch-ups: the recurring per-group newsletter ───────────────────────────
// Table names are chosen to NOT collide with the dead tables left by the
// reverted build: CatchupEdition (not CatchupIssue) and CatchupPrompt (not
// CatchupQuestion) are genuinely absent, no rename needed. BUT live DB
// introspection (2026-07-05) found the reverted build ALSO left physical
// "Catchup" and "CatchupPref" tables behind with THESE EXACT NAMES, and their
// columns do not match this schema (legacy Catchup has `creatorId`, not
// `createdById`; legacy CatchupPref has `optedOut boolean`, not
// `reminderMode`). Without a rename, `prisma.catchup.*` / `prisma.catchupPref.*`
// would silently read/write the wrong table (some queries "succeed" against
// stale columns, others throw missing-column errors) instead of the intended
// P2021 "table does not exist" pre-migration signal. `@@map` below points
// these two models at fresh physical table names so the section 6.3 migration
// SQL creates genuinely new tables; the Prisma Client property names
// (`prisma.catchup`, `prisma.catchupPref`) are unchanged, so no app code
// outside this file needs to change. See docs/spec/catchups.md section 6.
// The legacy Catchup/CatchupPref/CatchupAnswer/CatchupAnswerLove/CatchupIssue/
// CatchupQuestion tables are left untouched (contain leftover rows from the
// reverted build); dropping them is a separate, optional owner action.

model Catchup {
  id          String    @id @default(cuid())
  groupId     String    @unique
  createdById String?                       // the Keeper; nullable so the Catch-up survives if they leave
  title       String?                       // optional custom name; UI falls back to "{group} Catch-ups"
  intro       String?                       // one-line description on the home
  cadence     String    @default("monthly") // "biweekly" | "monthly" | "quarterly"
  status      String    @default("active")  // "active" | "paused" | "ended"
  // Shareable invite link (/catchups/join/<token>). A BEARER token: whoever
  // holds it can join, which is what a share link is. Not derived from `id`,
  // which is already public in every URL of this Catch-up. Nullable only
  // because the column was added to a live table; every row has one and
  // createCatchup* always writes one.
  inviteToken String?   @unique
  nextOpensAt DateTime?                      // when the next Round auto-opens (recurring cadences)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("CatchupsKept", fields: [createdById], references: [id], onDelete: SetNull)
  editions  CatchupEdition[]
  prefs     CatchupPref[]

  @@index([status, nextOpensAt])
  @@map("CatchupSeries") // see collision note above; legacy "Catchup" table exists with incompatible columns
}

model CatchupEdition {
  id               String    @id @default(cuid())
  catchupId        String
  number           Int
  theme            String?
  status           String    @default("collecting") // draft|collecting|answering|preparing|published
  questionsCloseAt DateTime?
  answersCloseAt   DateTime?
  publishAt        DateTime?                          // = answersCloseAt + 24h (the preparing ritual)
  publishedAt      DateTime?
  // Packed reminder bookkeeping, see `dailyBucket`/`withDailyBucket` in
  // src/lib/catchups.ts. Low byte = flags (4 = auto-extended once; 1 and 2 are
  // the retired two-days/last-day bits, inert on old rows). High bits = the
  // days-left value the last DAILY reminder was sent for, 0 for none.
  remindersSent    Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  catchup Catchup         @relation(fields: [catchupId], references: [id], onDelete: Cascade)
  prompts CatchupPrompt[]
  entries CatchupEntry[]

  @@unique([catchupId, number])
  @@index([status, publishAt])
}

model CatchupPrompt {
  id        String   @id @default(cuid())
  editionId String
  authorId  String                          // always stored, even when shown anonymously
  text      String
  category  String?                          // library set id (e.g. "valley-days") or null for custom
  source    String   @default("member")     // "library" | "member" | "keeper"
  showAsker Boolean  @default(true)          // false = submitted anonymously
  accepted  Boolean  @default(false)         // curated into the Round by the Keeper
  position  Int      @default(0)
  createdAt DateTime @default(now())

  edition CatchupEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  author  User           @relation("CatchupPromptsAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  entries CatchupEntry[]

  @@index([editionId, position])
}

model CatchupEntry {
  id        String   @id @default(cuid())
  editionId String                          // denormalized for fast whole-Round reads
  promptId  String
  authorId  String
  body      String?
  images    String?                          // JSON array of R2 urls (reuse /api/upload)
  songUrl   String?
  songTitle String?
  songArt   String?                          // Spotify oembed thumbnail_url
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edition CatchupEdition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  prompt  CatchupPrompt     @relation(fields: [promptId], references: [id], onDelete: Cascade)
  author  User              @relation("CatchupEntriesAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  loves   CatchupEntryLove[]

  @@unique([promptId, authorId])
  @@index([editionId])
}

model CatchupEntryLove {
  id      String @id @default(cuid())
  userId  String
  entryId String

  user  User         @relation("CatchupLoves", fields: [userId], references: [id], onDelete: Cascade)
  entry CatchupEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
}

model CatchupPref {
  id           String @id @default(cuid())
  catchupId    String
  userId       String
  reminderMode String @default("all")       // "all" | "last" | "off"

  catchup Catchup @relation(fields: [catchupId], references: [id], onDelete: Cascade)
  user    User    @relation("CatchupPrefs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([catchupId, userId])
  @@map("CatchupReminderPref") // see collision note above; legacy "CatchupPref" table has `optedOut boolean`, not `reminderMode`
}

// ─── Lab: per-room archive state for /lab (2026-07-30) ───────────────────────
// Replaces src/app/lab/archive-overrides.json: a deployed Vercel filesystem is
// read-only, so a file written at request time could never persist the owner's
// archiving on the domain. One row per room whose archived flag differs from
// its registry default (src/app/lab/_registry.ts); no row = default applies.
// Table created by prisma/migrations-manual/2026-07-30-lab-archive.sql (db
// push is blocked, see the Place note above); until it runs, reads fall back
// to the registry defaults via the P2021 guard in src/app/lab/_archive-state.ts.

model LabRoomState {
  href      String   @id // the room's registry href, e.g. "/lab/houses"
  archived  Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt
}

// One row per attempt to chip in on /support, created BEFORE the payer sees
// the Razorpay modal and updated afterwards. Rows in "created" that never move
// are abandoned checkouts, which is normal and worth being able to see.
//
// This table is the reason /support can ever show a real recovered figure
// instead of the hand-edited constant in cost-bar.tsx, and it is what makes
// both confirmation paths (browser callback, webhook) idempotent.
model Contribution {
  id     String  @id @default(cuid())
  // Nullable + SetNull: a deleted account must never take the record of its
  // money with it. Also leaves room for a future signed-out contribution.
  userId String?

  // Paise, always -- the unit Razorpay counts in. Rupees exist only in the UI.
  amount   Int
  currency String @default("INR")
  status   String @default("created") // "created" | "paid" | "failed"

  // Real money or a test payment. This database is shared by production AND
  // local dev (see AGENTS.md), and a Razorpay test order is indistinguishable
  // from a live one by its ids alone, so without this column a developer
  // clicking Contribute on localhost would land a row that looks exactly like
  // a real contribution. Derived from the key prefix, never from the client.
  // Anything summing this table for a public figure must filter on it.
  livemode Boolean @default(false)

  // Unique: this is the idempotency key. The browser callback and the webhook
  // both race to confirm the same order, and only one of them may win.
  razorpayOrderId   String  @unique
  razorpayPaymentId String?
  method            String? // "upi" | "card" | "netbanking" ... as Razorpay reports it
  failureReason     String?

  createdAt DateTime  @default(now())
  paidAt    DateTime?
  updatedAt DateTime  @updatedAt

  user User? @relation("Contributions", fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

// ─── Metric snapshots: the history the vendors will not keep ────────────────
//
// Sentry's free plan drops errors after 30 days. Vercel Analytics keeps 30.
// PostHog keeps a year. None of them will tell you in 2028 what the site
// looked like in 2026, and none of it can be recovered once dropped.
//
// A nightly job (scripts/ops/snapshot.mjs) writes one row per metric per day
// into OUR database, from every source at once. The admin room then reads only
// this table: fast, no API keys at page load, no vendor rate limit, and a
// history that outlives every free tier it was collected from.
//
// Key-value rather than a wide table on purpose. A new metric is a new string,
// not a migration, and this list is certain to grow.
model MetricSnapshot {
  id String @id @default(cuid())

  // The UTC day this describes. Date, not timestamp: two runs on one day must
  // collide and overwrite rather than quietly double-count.
  day    DateTime @db.Date
  // "db" | "sentry" | "posthog" | "github"
  source String
  // Dotted, e.g. "members.total", "letters.published", "errors.unresolved".
  metric String
  // Float, so a count and a conversion rate can share one column.
  value  Float

  capturedAt DateTime @default(now())

  // The idempotency key: re-running today's collection updates today's row.
  @@unique([day, source, metric])
  // The room's read: one metric's line over time.
  @@index([source, metric, day])
}

// ─── Presence and sessions: who is here, where, on what ─────────────────────
//
// The owner asked for this explicitly (2026-08-19): "who's online right now,
// where they are, what device, what page... how long is the average session".
// The stated purpose is finding where older alumni get stuck, and it is
// disclosed in the site's policies.
//
// WHY A TABLE rather than more columns on User: a column can only hold the
// LAST value, which answers "where is Ravi now" and nothing else. Session
// length, pages per visit, and "how often does someone come back" are all
// questions about a span of time, and a span needs a row.
//
// A Visit is a span of activity with no gap longer than SESSION_GAP_MIN
// (src/lib/last-seen.ts). Cross that gap and the next page view opens a new
// Visit, which is the standard definition and the one that makes "average
// session" mean what a person expects it to mean.
model Visit {
  id     String @id @default(cuid())
  userId String

  startedAt DateTime @default(now())
  // Last activity in this visit. The visit's length is endedAt - startedAt,
  // so a single-page visit is legitimately zero rather than a guess.
  endedAt   DateTime @default(now())
  views     Int      @default(1)

  // Where they were when it ended. Kept on the visit rather than per view:
  // a per-view table is a firehose that answers little more, and PostHog
  // already holds the full path-by-path journey.
  lastPath String?
  // The FIRST page of the visit. The pair (entryPath, lastPath) is the cheap
  // version of a journey: where people come in and where they stop.
  entryPath String?
  // Where they came from, host only. The full URL would carry query strings
  // (search terms, tracking ids) belonging to somebody else's site.
  referrer String?

  // Parsed from the user agent, coarse on purpose. "phone | tablet | desktop"
  // is what answers "are the older alumni on phones"; the exact model is not
  // a question anyone has.
  device  String?
  os      String?
  browser String?
  // Browser UI language, e.g. "en-GB". The one honest signal about whether
  // anyone needs this site in another language.
  language String?

  // From Vercel's edge headers, which cost nothing -- they are on every
  // request already. Absent in local development, so all are nullable.
  country  String?
  city     String?
  region   String?
  timezone String?
  // Coarse coordinates from the same headers. Enough to put a visit on the
  // directory's existing map; never a street address.
  lat      Float?
  lng      Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "Who is online right now" and "recent visits", the two live reads.
  @@index([endedAt])
  // One person's history, and the lookup that decides whether to extend the
  // current visit or open a new one.
  @@index([userId, endedAt])
}

// ─── What people look for ───────────────────────────────────────────────────
//
// The owner asked for "the most common searches" in the session that
// commissioned the analytics room, and nothing recorded them: the header pill
// submits to /feed?q= and the directory filters in the browser, so every query
// anyone has ever typed was thrown away.
//
// The query text is stored as typed. That is the entire point -- "what are
// people failing to find" cannot be answered by a count -- and it is covered
// by the same disclosure as the rest of the presence data.
model SearchLog {
  id     String  @id @default(cuid())
  userId String?

  // "feed" | "directory" | "people" | "places"
  scope String
  query String
  // How many rows came back. A query with zero results is the useful one: it
  // is somebody looking for a person or a place this site could not show them.
  results Int?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // "What is searched most", and the zero-result list.
  @@index([scope, createdAt])
  @@index([query])
}

// ─── Who looks at what, and how often ───────────────────────────────────────
//
// The owner asked for two things this answers at once: the curiosity ("who
// searches for whose profile, how often") and the product question ("read
// click-through rates" -- does anything written actually get read).
//
// A COUNTER, not a log, and that choice is load-bearing. A row per view is
// unbounded: 2,000 members at twenty views a day is 14M rows a year, which is
// gigabytes on a 500MB plan. Keyed on (viewer, kind, target) it is bounded by
// distinct PAIRS instead -- a member might look at fifty profiles ever, so
// 2,000 members is ~100k rows total, and it answers "how often does A look at
// B" better than a log does, because the answer is one column rather than a
// count over a scan.
//
// firstAt/lastAt keep what the counter would otherwise lose: whether an
// interest is old or current.
model ContentView {
  id String @id @default(cuid())

  viewerId String
  // "profile" | "letter" | "post" | "photo" | "round"
  kind     String
  // The profile's user id, the letter's post id, and so on. Not a foreign key:
  // one column cannot reference five tables, and a view of something later
  // deleted is still a true fact about what someone was interested in.
  targetId String

  count   Int      @default(1)
  firstAt DateTime @default(now())
  lastAt  DateTime @default(now())

  viewer User @relation("ContentViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  // The upsert key.
  @@unique([viewerId, kind, targetId])
  // "Who is looking at this", and the most-viewed lists.
  @@index([kind, targetId])
  // "What has this person been looking at", and recency.
  @@index([viewerId, lastAt])
}

// ─── Who could not get in ───────────────────────────────────────────────────
//
// The owner's reason for the analytics room is finding where older alumni get
// stuck, and somebody who cannot sign in AT ALL is the strongest possible
// version of that -- and was completely invisible, because a failed login left
// no trace anywhere. They simply never appeared in any number.
//
// Never stores a password or any part of one. The email is stored as typed,
// because "which address did they keep trying" is the whole point: a member
// entering the wrong address is a different problem from one entering the
// wrong password, and only the address distinguishes them.
model LoginAttempt {
  id String @id @default(cuid())

  // Lowercased as submitted. May belong to no account at all, which is itself
  // one of the more common failures.
  email  String
  // Set when the address matched an account, so a decade can be attached.
  userId String?

  ok Boolean
  // "ok" | "no-account" | "no-password-set" | "wrong-password"
  reason String

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email, createdAt])
  @@index([userId, createdAt])
}

// ─── The office roster ───────────────────────────────────────────────────────
//
// The school's registration sheets, consolidated (owner, 2026-08-19: the
// Centenary registrations plus the old rishivalley.xls Master list), so a
// signup that matches them verifies itself with verifyMethod "office_list"
// and the owner can see it was the sheets that vouched, not him. Written only
// by scripts/dev/import-roster.mjs; read only by src/lib/roster.ts.
//
// Deliberately carries NOTHING beyond what matching needs -- no addresses, no
// phones, no admission numbers -- because a roster row is somebody who never
// signed up, and holding their data beyond name/email/batch is liability with
// no function. Auto-fill from the sheets is explicitly off (owner call).
model RosterEntry {
  id             String  @id @default(cuid())
  fullName       String  // as printed on the sheet, initials stripped
  normalizedName String  // lowercased, diacritics and punctuation collapsed (roster-rule.ts)
  email          String? // lowercased; most Master rows have none
  batchYear      Int?    // "Batch" / "Year of Passing" as the sheet stated it
  source         String  // "centenary-2026" | "master" | "phase3-probe"
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([normalizedName, batchYear])
}
