generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────
//  ELEVEN INDEXES EXIST THAT THIS FILE CANNOT DESCRIBE.
//
//  They are expression, trigram and partial indexes. Prisma has no syntax
//  for any of the three, so `prisma migrate diff` reads this file, does not
//  find them, and offers to create or DROP them. It is wrong every time.
//  This is the authoritative list; counted from `pg_indexes` on 2026-09-05.
//
//    User_email_lower_key        UNIQUE (lower(email))
//                                2026-08-21-email-canonical.sql
//    User_name_trgm_idx          GIN (name gin_trgm_ops)
//    Photo_caption_trgm_idx      GIN (caption gin_trgm_ops)
//    Photo_area_trgm_idx         GIN (area gin_trgm_ops)
//    Photo_freeTags_trgm_idx     GIN (freeTags gin_trgm_ops)
//                                2026-08-28-collection-river.sql
//    Place_altNames_trgm_idx     GIN (altNames gin_trgm_ops)
//                                2026-08-21-gazetteer-trigram.sql
//    Place_name_idx              btree (lower(name) text_pattern_ops)
//    Place_asciiName_idx         btree (lower(asciiName) text_pattern_ops)
//    UserPlace_city_idx          btree (lower(city))
//                                2026-07-18-round6.sql
//    Report_open_post_per_reporter_key
//                                UNIQUE (reporterId, postId) WHERE targetType
//                                = 'post' AND status = 'pending' AND postId
//                                IS NOT NULL
//                                2026-08-25-report-one-open-per-post.sql
//    User_lastSeenAt_idx         btree (lastSeenAt) WHERE lastSeenAt IS NOT NULL
//                                2026-08-19-analytics.sql
//
//  The last one is the trap inside the trap. It looks like a plain index
//  Prisma could express, and refactor audit 2 was told to add
//  `@@index([lastSeenAt])` to User for it. Do not: it is PARTIAL, and a plain
//  @@index is a different index, so declaring one makes `migrate diff` want to
//  drop the live partial one and build a worse replacement. It serves the two
//  range counts in admin-analytics.ts's loadPeople and loadFaces's
//  `lastSeenAt IS NOT NULL`, and it serves them from SQL alone.
//
//  The demo database has only SEVEN of the eleven -- the four created before
//  the demo project existed (2026-08-21) never reached it. Logged in
//  docs/planning/bugs.md; check both before assuming.
// ─────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String?
  emailVerified DateTime?
  photoUrl      String?   // uploaded profile photo; overrides the bird avatar everywhere
  bio           String?
  about         String?   // long-form "in their words" paragraph (profile About tab)
  currentCity   String?   // primary city, shown everywhere
  secondaryCity String?   // optional second base, shown on the profile and searchable
  houses        String?   // JSON string of [{year, house}]; canonical house list in src/lib/houses.ts
  displayEmail  String?   // profile may show a different email than the sign-in one
  // Whether the profile prints an email address at all. Separate from
  // displayEmail because NULL there means "no CUSTOM address chosen", which is
  // the ordinary case and must keep showing the sign-in one. Without this
  // column there was no way to say "show none", and clearing the row served the
  // member's private login address instead (audit B-050).
  showEmail     Boolean   @default(true)
  birdOverride  String?   // manual bird-species slug override (admin assignment + supporter perk)
  birdPickedAt  DateTime? // when the supporter last spent a pick; a paid contribution NEWER than this grants another (see chooseBird)
  workplace     String?
  jobTitle      String?
  /// Derived profession tags. NOBODY TYPES THIS -- it is written only by the
  /// hand-run pass in scripts/dev/tag-professions-*.mjs, because the bucket a
  /// member belongs in is only readable from the PAIR above: `workplace` holds
  /// the organisation ("Tufts University") and `jobTitle` the role ("Student"),
  /// so no single column can be filtered on directly.
  ///
  /// Plain TEXT[] with NO enum and NO check constraint, deliberately. The
  /// vocabulary lives in src/lib/profession-tags.ts and has to be able to
  /// change -- a tag added, split in two, merged or dropped -- and one database
  /// serves production and local dev, so a constraint would turn every
  /// vocabulary edit into a migration with an outage window. The database holds
  /// strings; profession-tags.ts is what says which strings mean anything.
  professionTags String[] @default([])
  /// The exact (jobTitle, workplace) pair the tags above were judged from, as
  /// JSON. Lets the pick script find people whose text has CHANGED since they
  /// were tagged, without re-judging everybody. Deliberately not a vocabulary
  /// version stamp: that would mark the whole membership stale every time one
  /// tag is added, forcing a full re-run for a small change. Re-judging is
  /// targeted (--tag, --all), never automatic.
  professionTagSource String?
  phone         String?
  phones        String?   // JSON string of string[] (bare numbers; the first one is mirrored into legacy `phone`)
  instagram     String?
  linkedin      String?
  facebook      String?
  links         String?   // JSON array of {label, url}: user-defined "Other links" rows (Contact section)
  accountType   String    @default("alumnus") // "alumnus" | "teacher" | "ex_teacher"
  batchType     String?   // derived board credential: "ISC" (left in 12), "ICSE" (left in 10/11), null for mid-school leavers and teachers
  batchYear     Int?      // year the person's class would finish 12th (their "Batch of"); derived, not the year they left
  yearJoined    Int?      // calendar year they started (beginning of an academic year)
  yearLeft        Int?    // calendar year they left (end of an academic year)
  gradeJoined   Int?      // grade they were in when they joined; with yearJoined/yearLeft this pins the batch
  admissionNumber Int?
  taughtFrom    Int?      // teacher tenure start
  taughtUntil   Int?      // null = still teaching
  subjects      String?   // comma list, e.g. "Biology, Nature Club"
  role          String    @default("member") // "member" | "admin"
  verifyState   String    @default("unverified") // unverified | pending | verified | flagged
  // When verifyState last changed. STAMP THIS WHENEVER YOU WRITE verifyState:
  // it is the only honest ordering the admin worklist has.
  //
  // WHY: the queue used `updatedAt`, which Prisma bumps on every write to the
  // row -- including the fifteen-minute lastSeenAt stamp from the (main)
  // layout. So "who has waited longest to be verified" really read "who has
  // been away longest", and a member browsing the site sat at the top of the
  // owner's worklist saying "3m ago" for as long as their tab was open, whether
  // they had asked that minute or a fortnight ago (audit M04).
  //
  // NOT NULL, defaulting to now(): a new account's state ("unverified") does
  // begin at signup, so there is no meaningful null and the queues never need a
  // fallback ordering.
  verifyStateAt DateTime  @default(now())
  verifiedAt    DateTime?
  verifyMethod  String?   // office_list | community | admin_manual
  // Blocking is a capability switch, not a delete. It ends every live session
  // (via credentialVersion below), refuses the next sign-in, and holds the
  // account out of the directory and search.
  //
  // It ALSO hides everything they have already written: posts, letters and
  // comments leave the feed with them (owner decision, 2026-08-21, audit
  // Low 78 -- the directory and the feed used to disagree, and their name
  // linked to a profile that answers 404 for everybody else). One fragment,
  // `AUTHOR_IN_GOOD_STANDING` in lib/posts.ts, so no feed can forget it, and
  // `decidePostVisibility` refuses the direct link so a list and a URL cannot
  // say different things. Nothing is deleted: unblocking restores all of it.
  //
  // Deliberately NOT extended to the Collection: a photograph there was
  // approved by an admin into a shared archive of the school's history, which
  // is a different thing from something the member published under their own
  // name. Take one down individually if it needs to go.
  isBlocked     Boolean   @default(false)
  // Bumped whenever this account's credentials or standing change: a password
  // reset or change, a block, an unblock. The value is copied into the JWT at
  // sign-in and compared on every session read, so raising it invalidates every
  // token already in the wild.
  //
  // WHY: sessions are JWTs with no server-side store, so before this there was
  // no way to end one. A phished member could reset their password and the
  // attacker's cookie kept working for its full 30 days (audit M4); blocking
  // somebody removed them from the directory but left them posting (audit H4).
  // The same one column answers both, plus the deleted-account case, which is
  // the only revocation primitive this design can have.
  credentialVersion Int   @default(0)
  // Self-deletion is a request, not an event (audit M35): set when the member
  // confirms deletion with their password, cleared if they sign back in during
  // the 60-day grace period (the owner's retention decision, 2026-08-19), and
  // acted on by the retention sweep, which purges the row and every stored
  // image once the window has passed (audit H9). While set, the account is
  // held out of the directory and search the same way a blocked one is.
  deletionRequestedAt DateTime?
  // When this person ticked the signup consent box linking the privacy
  // policy, terms and community guidelines (audit H12). Null for members who
  // joined before the box existed; the owner's decision records that existing
  // members are assumed to agree, so null is never treated as missing consent.
  consentAt     DateTime?
  adminNote     String?
  theme         String?   // UI theme preference: "light" | "dark"; null = light (the default, so existing rows need no backfill). Mirrored into the rv-theme cookie (src/lib/theme.ts) for SSR.
  // Last time this member loaded an authenticated page, rounded to ~15 minutes
  // (src/lib/last-seen.ts). THE ONE QUESTION THE DATABASE COULD NOT ANSWER:
  // "who is still using this". Impossible to backfill -- there is no history to
  // recover -- so it was added the day the analytics room was built rather than
  // discovered missing afterwards.
  lastSeenAt    DateTime?
  // createdAt of the newest post this member has already been shown in the
  // feed, which is what the "New since you were last here" divider draws
  // against. It lived in localStorage until 2026-08-20, so the divider was
  // per-browser: signing in on a phone and a laptop meant being told the same
  // posts were new twice (owner: "should only appear once, not once on each
  // device"). Only ever moves forward, so the older of two devices catching up
  // cannot rewind it. Null = never seen a feed; the divider stays hidden.
  feedSeenAt    DateTime?
  visits        Visit[]
  searches      SearchLog[]
  contentViews  ContentView[] @relation("ContentViewer")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  posts         Post[]
  comments      Comment[]
  likes         Like[]
  commentLikes  CommentLike[]
  pollVotes     PollVote[]
  reports       Report[]       @relation("ReportsFiled")
  reportsAgainst Report[]      @relation("ReportsAgainst")
  notifications Notification[]
  coverPhoto    String?   // a Collection photo url reused as profile cover
  photoTrusted  Boolean   @default(false) // auto-approve this uploader's future photos

  authTokens    AuthToken[]
  outboundMail  OutboundEmail[]
  bookmarks     Bookmark[]
  groupMemberships GroupMember[]
  createdGroups    Group[]
  photos         Photo[]     @relation("PhotoUploader")
  approvedPhotos Photo[]     @relation("PhotoApprover")
  photoLoves     PhotoLove[]
  places         UserPlace[]

  // Member <-> admins conversations (see AdminThread below).
  adminThreads    AdminThread[]      @relation("AdminThreadMember")
  adminMessages   AdminMessage[]     @relation("AdminMessageAuthor")

  // Catch-ups (the recurring group newsletter). Back-relations for the six Catchup* models.
  catchupsKept    Catchup[]          @relation("CatchupsKept")
  catchupPrompts  CatchupPrompt[]    @relation("CatchupPromptsAuthored")
  catchupEntries  CatchupEntry[]     @relation("CatchupEntriesAuthored")
  catchupLoves    CatchupEntryLove[] @relation("CatchupLoves")
  catchupPrefs    CatchupPref[]      @relation("CatchupPrefs")

  contributions   Contribution[]     @relation("Contributions")

  // GIN, because the directory filters this column with `has` (a Postgres `@>`
  // containment) and counts it with `unnest`. A B-tree cannot answer either:
  // it would index the array as one opaque value, so every profession filter
  // would be a sequential scan over the whole membership.
  @@index([professionTags], type: Gin)
  // Three more exist in the database and cannot appear here -- see the header:
  // the unique on lower(email) that makes address canonicalisation real, the
  // GIN trigram on name that serves every people search, and the PARTIAL index
  // on lastSeenAt that serves the analytics room's activity counts. None of
  // them is expressible in this file. Do not add a plain @@index in their
  // place: a plain one is a different index, and declaring it is how a routine
  // `migrate diff` ends up proposing to drop a live one.
}

/// What we know about the bytes at one stored image URL: its true shape, where
/// the interesting part of it is, and a 16px smear of it to show while the real
/// thing arrives.
///
/// Why this exists at all. `Post.images` and `CatchupEntry.images` are JSON
/// arrays of URL STRINGS, so until now the app knew nothing about a feed,
/// letter or Catch-up photograph except where to fetch it. That single gap is
/// why the page jumps as each photo lands (nothing can reserve the space), why
/// `image-cdn.ts` had to be a URL helper rather than a real component, why a
/// justified row cannot be solved (the algorithm needs every aspect ratio up
/// front) and why a 20,000-image grid cannot be windowed (a scrollbar needs row
/// heights). See docs/planning/collection-rework/spec.md §2.
///
/// Keyed by URL, not by a foreign key to Post. That is the whole trick: nothing
/// else in the schema moves, no existing row is migrated, and a caller looks up
/// the URLs it is already holding. A URL with no row here is not an error --
/// the renderer falls back to what it did before -- which is what makes the
/// backfill lazy and this table safe to add mid-flight.
///
/// `Photo` (the Collection) keeps its own width/height and does not need a row
/// here; it has carried dimensions since the day it was written.
model Image {
  /// The public URL the bytes serve from, which is already unique: every stored
  /// object gets a fresh cuid filename.
  url         String   @id

  /// The stored image's own pixels, after EXIF rotation and after the 1920 box
  /// `toDisplayWebp` puts it in -- the shape the browser will actually receive,
  /// not the shape that left the camera.
  width       Int
  height      Int

  /// Where the interesting part is, 0..1 from the top-left, from sharp's
  /// `attention` strategy at upload. 0.5/0.5 means "we could not tell", which is
  /// also the default, so a consumer never has to special-case a missing guess.
  ///
  /// Stored RAW and unclamped. The clamp that keeps a bad guess from doing
  /// damage (a tall photo's window may travel between 15% and 50% down the
  /// frame, and no further) belongs to the layout rule, not to the measurement,
  /// so it can be retuned without re-reading twenty thousand files. X withdrew
  /// its own saliency crop after measuring real bias in it, so this number is
  /// only ever a nudge inside a clamp, and the uploader can overrule it.
  focalX      Float    @default(0.5)
  focalY      Float    @default(0.5)

  /// True once the UPLOADER has aimed the crop by hand, which turns the clamp
  /// above off for this image.
  ///
  /// The clamp is a brake on a GUESS, not on a person. sharp's `attention` is a
  /// contrast heuristic that goes for the bright sky -- of the first 41 images
  /// measured, 14 landed within 3% of an edge -- so a bad guess has to be
  /// bounded. A person dragging the window has looked at the photograph, and X's
  /// own conclusion after withdrawing their saliency crop was that "how to crop
  /// an image is a decision best made by people". Braking them would make the
  /// handle lie: the window would stop somewhere they did not put it.
  ///
  /// Separate column rather than a sentinel value in focalY, because every
  /// position a person can choose is also a position the machine can guess.
  focalSet    Boolean  @default(false)

  /// True for a photograph with no colour in it, measured rather than declared
  /// (spec §7.4: a filter nobody has to tag for). Sepia and faded prints read as
  /// colour here, which is honest -- they have a hue.
  greyscale   Boolean  @default(false)

  /// A 16px-longest-edge WebP of the image as a data URI, about 160 bytes: the
  /// thing to show in the reserved space while the real photograph loads. Same
  /// convention as `next/image`'s `blurDataURL`, so it can be handed straight to
  /// one. Null when the smear could not be made, which is not worth failing for.
  blurDataUrl String?

  createdAt   DateTime @default(now())
}

model Photo {
  id           String    @id @default(cuid())
  uploaderId   String

  thumbUrl     String    // 480px  — the river
  // NOT 1600px, whatever this comment said until 2026-09-05. The direct
  // contribute path stores full resolution at WebP q100, bounded only by a
  // 40MP AREA cap against decompression bombs; only the FormData fallback
  // boxes to 1600 at q80. Both encodes are in collection/actions.ts, and
  // docs/spec/media.md §4.2 has the table.
  url          String    // full resolution (direct) or 1600px (fallback) — viewer, reusable as a post/cover image
  width        Int
  height       Int

  caption      String?

  /// The staged upload this row was made from, held UNIQUE so it can only be
  /// made once. A direct upload PUTs its original under a fresh key and then
  /// calls contributePhotoDirect with it; two of those calls landing together
  /// both read the original before either deleted it, so both re-encoded it
  /// and both created a row -- two Collection photos and two pairs of stored
  /// objects from one contribution, and a per-account quota checked before
  /// either insert (audit C-129). Null for every row made before this and for
  /// the proxied path, which has no staged key of its own.
  sourceKey    String?   @unique

  // The six buckets, comma-joined: "people,school-life". Validated by Zod
  // against src/lib/collection.ts BUCKETS, which replaced the fourteen-value
  // list this column used to hold (2026-08-28 -- the old vocabulary was drawn
  // up under "the place, not people" and had nowhere to file a class
  // photograph). The COLUMN is deliberately not renamed to `buckets`: one
  // database serves production and local dev, so a rename breaks every
  // Collection query in production until the next deploy lands, and
  // legibility does not buy an outage window. `bucketsOf()` reads it and maps
  // any surviving old value on the way through.
  subject      String    // e.g. "campus,school-life"
  era          String    @default("unknown") // decade bucket, derived from photoYear when given
  // `area` ("Part of school") and `freeTags` (bird/species names) were here.
  // Both left the contribute form in the 2026-07-18 rework, and on 2026-09-07
  // the code stopped reading and writing them: 0 of 1,749 rows carried either,
  // on production and on the demo. The columns and their two trigram indexes
  // are still in both databases until the owner runs
  // prisma/migrations-manual/2026-09-07-drop-collection-legacy-tags.sql.

  // "When", as given by the contributor: an exact year (photoYear), an
  // optional month alongside it, or -- when they weren't sure of the exact
  // year -- just the decade fallback stored in `era` above. datePrecision
  // records which of those they actually gave.
  photoYear     Int?
  photoMonth    Int?      // 1-12; only meaningful alongside photoYear
  datePrecision String?   // "month" | "year" | "decade" | "unknown"

  /// What the FILE said, as opposed to what the contributor said. Read off
  /// the original's EXIF in the seconds it exists, before the re-encode
  /// strips it and the original is deleted.
  ///
  /// A SUGGESTION, NEVER AN ANSWER. Nothing derives from these two columns:
  /// `takenKey` does not read them, no filter groups by them, and a
  /// photograph with an exifYear and no photoYear is undated in every sense
  /// the Collection means it. They exist so the review room can say "the file
  /// says 2019" and an admin can take it in one press -- which writes
  /// photoYear like any other answer. The reason for the distance is that on
  /// a scanned print this is the SCAN date, not the photograph's: right about
  /// the file, wrong about the picture, and only a person looking at the
  /// picture can tell which.
  ///
  /// Date only. The reader (src/lib/exif-date.ts) does not know the GPS tags
  /// exist, so there is no location here to leak (audit M12).
  exifYear      Int?
  exifMonth     Int?      // 1-12, or null when the stamp had only a year

  /// When it was taken, as ONE sortable integer: year * 100 + month, so
  /// March 1978 is 197803, a bare 1978 is 197800, "the 1970s" is 197000 and
  /// an undated photograph is 0 (sorting last under DESC with no NULLS
  /// clause, and giving the keyset cursor a plain two-column comparison
  /// instead of a three-branch OR with a null case in it).
  ///
  /// GENERATED ALWAYS ... STORED in Postgres, computed from photoYear,
  /// photoMonth and era -- see prisma/migrations-manual/2026-08-28-collection-river.sql.
  ///
  /// `dbgenerated()`, and it has to be. A plain `@default(0)` is a PRISMA-side
  /// default, which Prisma applies by writing the column into every INSERT --
  /// and Postgres refuses a non-DEFAULT value for a generated column, so every
  /// contribution failed the moment this column existed. `dbgenerated()` is
  /// how Prisma is told the database owns it: it is read and never written.
  takenKey      Int       @default(dbgenerated())

  /// Which half of the Collection this photograph belongs to: "valley" (the
  /// school's shared visual memory, which every member sees) or "class" (a
  /// member's own class, which only that class sees).
  ///
  /// An EXPLICIT discriminator, and never a nullable audience column meaning
  /// "everyone" -- a null that reads as public is how a default-open leak
  /// gets written. Every read path names a scope positively; the rule is
  /// src/lib/photo-visibility-rule.ts and the sweep is pinned by
  /// src/lib/security-regressions.test.mjs.
  scope        String    @default("valley")

  /// The classes that may see a class-scoped photograph, as a comma list of
  /// batch years ("2004"). Null for every valley-scoped row.
  ///
  /// A LIST though exactly one is ever written today. The audience is exact
  /// batch-year equality (docs/planning/class-collection/spec.md sec. 2), and
  /// the one thing that might widen it later is letting an uploader name the
  /// class above as well. A list costs nothing now and saves a migration on a
  /// table that will by then hold tens of thousands of rows.
  ///
  /// Read with classYearsOf()/classYearsInclude() in photo-visibility-rule.ts,
  /// which match TOKEN-EXACTLY: a plain `contains` matches a stored "20111"
  /// against a viewer keyed "2011" and shows a photograph to the wrong class.
  classYears   String?

  approved     Boolean   @default(false)
  isHidden     Boolean   @default(false)
  approvedAt   DateTime?
  approvedById String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  uploader   User        @relation("PhotoUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  approvedBy User?       @relation("PhotoApprover", fields: [approvedById], references: [id])
  loves      PhotoLove[]

  @@index([approved, isHidden, createdAt])
  @@index([era])
  // 'Photos by this member', and the purge's own lookup (B-090).
  @@index([uploaderId])
  // The river's two orders and the decade rail's grouped count. Each ends in
  // the tiebreak that makes its ordering total, which is what lets the page
  // be cursored instead of offset: a keyset page over a partial ordering can
  // repeat a row and skip another (audit B-122).
  @@index([approved, isHidden, takenKey(sort: Desc), id(sort: Desc)], name: "Photo_river_taken_idx")
  @@index([approved, isHidden, createdAt(sort: Desc), id(sort: Desc)], name: "Photo_river_added_idx")
  @@index([approved, isHidden, era], name: "Photo_river_era_idx")
  // The Class Collection's river. Mirrors Photo_river_taken_idx and keeps the
  // property that one depends on: it ends in the tiebreak that makes the
  // ordering total, which is what lets the page be cursored instead of
  // offset. A keyset page over a partial ordering can repeat a row and skip
  // another (audit B-122) -- do not drop the trailing id from this one either.
  @@index([scope, classYears, approved, isHidden, takenKey(sort: Desc), id(sort: Desc)], name: "Photo_class_river_idx")
  // Three GIN trigram indexes on caption, area and freeTags exist in the
  // database and cannot appear here -- see the header. Collection search is
  // `contains`, which is `ILIKE '%x%'`, which nothing but a trigram index
  // serves. It is not unindexed; do not "fix" it.
}

model PhotoLove {
  id      String @id @default(cuid())
  userId  String
  photoId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([userId, photoId])
  @@index([photoId])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  // `description` and `coverImage` were here. Neither ever had a reader: the
  // description was a generated sentence ("Everyone from the batch of 2010.")
  // written by signup and by the demo seed, the cover image had no writer at
  // all. Removed from the code on 2026-09-07 (refactor audit 2 / D6); the two
  // columns are still in both databases until the owner runs
  // prisma/migrations-manual/2026-09-07-drop-groups-residue.sql.
  // Set ONLY on an auto-created "Batch of {year}" group, and unique, so a batch
  // has exactly one. It used to be identified by its name alone, which nothing
  // constrained -- so two members of the same batch registering in the same
  // second both missed the findFirst and both created "Batch of 2010", and
  // every later signup landed in whichever one the unordered findFirst
  // returned. The batch was permanently split into two groups whose members
  // could not see each other, and launch day is exactly the concurrency this
  // needs (bug audit B-121). Null on every other group; Postgres allows many
  // NULLs under a unique index.
  batchYear   Int?     @unique
  // Nullable, and SetNull, so the group outlives the person who happened to
  // start it. It used to be Cascade, which meant the first alumnus of a batch
  // to sign up silently owned "Batch of 2010", and whoever started a Catch-up
  // owned its hidden Group -- so deleting that one account took the group, the
  // Catch-up, every Round and every OTHER member's answers with it. A null
  // creator is a group nobody owns; any remaining member may act as Keeper
  // (spec 7, and `promoteOrphanedGroups` in account-purge.ts leaves an admin
  // behind so the powers are never unreachable).
  creatorId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator  User?         @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  members  GroupMember[]
  catchup  Catchup?

}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("member") // "admin" | "member"
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  // Postgres can only use a composite index when the LEADING column is
  // constrained, and loadSavedPosts asks for one member's memberships by
  // userId alone on every request -- the same shape as B-090 (audit C-192).
  @@index([userId])
}

// ─── Email tokens: password reset and address confirmation ───────────────────
// One row per link we mail out. NOT NextAuth's VerificationToken above, which
// belongs to the (unused) email provider and stores its token in the clear.
//
// `tokenHash` is a SHA-256 of the random token, and the raw token exists in
// exactly one place: the URL in the person's inbox. So a leaked database
// backup, a stray log line, or a read-only SQL injection cannot be turned into
// an account takeover, which a plaintext reset table hands over outright. The
// hash is the primary lookup key, so verifying a link is one indexed read and
// the raw value is never sent to Postgres at all.
//
// `usedAt` rather than a delete: a consumed row is kept so a second click on
// the same link can say "this link was already used" instead of the identical
// "invalid link" a missing row would produce. Those are different problems for
// the person reading the screen, and telling them apart is most of what makes
// this flow survivable for someone who is not good with computers.
model AuthToken {
  id     String @id @default(cuid())
  userId String
  // "reset" (set a new password) | "verify" (confirm this address is yours).
  // Checked on consume, so a confirmation link can never be replayed as a
  // password reset even if the two ever shared a token space.
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  // The address the link was sent to. Kept so a reset issued before someone
  // changes their email cannot be redeemed afterwards, and so the "we sent it
  // to a****@gmail.com" line can be rebuilt without a second lookup.
  sentTo    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The rate-limit read: "how many of this kind has this user asked for
  // recently". Ordered so the count is an index-only scan.
  @@index([userId, kind, createdAt])
  // The sweep read: expired rows are deleted opportunistically on mint.
  @@index([expiresAt])
}

// ─── The outbound mail queue ─────────────────────────────────────────────────
// Resend's free plan sends 100 messages a day. Launch is expected to put more
// than 100 signups through in the first day (owner, 2026-08-11), so mail is
// NOT sent inline from the action that triggers it. Every message becomes a
// row here and a drain pass sends what the day's budget allows, oldest first
// within priority. The rest wait for tomorrow.
//
// Two decisions in this shape are worth keeping:
//
// 1. The message is stored as its INGREDIENTS (`payload`), not as rendered
//    HTML. A template fix therefore reaches everything still queued, and the
//    table stays small enough to ignore.
// 2. Nothing here holds a token. The AuthToken is minted by the drain, at the
//    moment of sending. A verify link minted at signup and posted two days
//    later would arrive already dead, which is the exact failure a queue
//    introduces if you are not looking for it.
model OutboundEmail {
  id     String  @id @default(cuid())
  userId String?
  to     String
  // "verify" | "reset" | "password-changed". Decides which template renders
  // and which token, if any, gets minted at send time.
  kind String
  // Template inputs as JSON (a name, an address). Never a token, never a
  // password, never anything that would matter if this table leaked.
  payload String?
  // Lower sends first. A password reset is somebody locked out RIGHT NOW; a
  // welcome confirmation can wait a day without anyone being stuck.
  priority Int @default(100)

  status    String    @default("queued") // queued | sending | sent | failed
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())

  // When the drain may pick this row up again. Null means "now".
  //
  // Without it a requeued row kept its original createdAt, so it was still the
  // oldest eligible row and the very next iteration of the SAME pass took it:
  // four attempts inside four seconds, then permanently failed. A thirty-second
  // Resend brownout turned every queued reset into mail nobody would ever send
  // and nothing would ever retry (bug audit B-002).
  nextAttemptAt DateTime?
  // Failures the PROVIDER caused (a 429, a 5xx, a dropped socket). Counted
  // apart from `attempts` because they say nothing about the address: they
  // stretch the backoff and eventually give up, but they never spend the
  // budget reserved for finding out that somebody typed `gmial`.
  deferrals     Int      @default(0)

  // --- Delivery, as the PROVIDER saw it (2026-08-19) -------------------
  // `status` above only ever meant "Resend accepted this from us". It says
  // nothing about whether the mail reached a human. At launch, when a few
  // hundred invitations go out at once, the difference between "400 sent"
  // and "400 delivered" is the difference between a working launch and a
  // silent one. These are written only by the Resend webhook
  // (src/app/api/resend/webhook/route.ts), never by the send path.

  // Resend's own id for the message, captured at send time. The join key: a
  // webhook event carries this and nothing else that identifies the row.
  providerId String?

  deliveredAt DateTime?
  // A hard bounce means the address is dead and retrying is pointless; a
  // soft bounce is a full mailbox or a temporary refusal. Stored raw as
  // Resend reports it rather than collapsed to a boolean, because the two
  // deserve different handling and that decision is not made here.
  bouncedAt   DateTime?
  bounceKind  String?
  // Someone pressed "this is spam". Rare, and the single most damaging
  // signal for a young sending domain, so it is recorded separately.
  complainedAt DateTime?
  // Set while a drain pass owns this row, so two concurrent page views cannot
  // both send it. A row stuck in "sending" past the stale window is reclaimed.
  claimedAt DateTime?
  sentAt    DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The drain read: the next thing to send that is due.
  @@index([status, nextAttemptAt, priority, createdAt])
  // The budget read: how many went out since midnight UTC.
  @@index([sentAt])
  // "Has this person's confirmation actually left yet?", which is what decides
  // whether the app may tell them to go and look in their inbox.
  @@index([userId, kind, status])
  // The webhook read: find the row a provider event belongs to.
  @@index([providerId])
}

model Post {
  id            String    @id @default(cuid())
  authorId      String
  kind          String    @default("post") // "post" | "letter"
  title         String?   // used by letters
  content       String
  targetBatches String?
  images        String?
  cityScope     String?   // null = everyone; otherwise the city short-name this post is limited to (admins see all)
  isHidden      Boolean   @default(false)
  status        String    @default("published") // "published" | "draft" — drafts are letters saved before sending; only ever visible to their author
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    Comment[]
  likes       Like[]
  bookmarks   Bookmark[]
  pollOptions PollOption[]
  pollVotes   PollVote[]
  reports     Report[]

  @@index([kind, createdAt])
  @@index([createdAt])
  // A profile's Posts and Letters tabs filter on the author (B-090).
  @@index([authorId, createdAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  // Nullable, and SetNull rather than Cascade, for one reason: a purged
  // account must not take other members' replies down with it or promote them
  // to top-level. A root comment with replies hanging off it survives the
  // purge as a blanked, authorless stub -- exactly what deletedAt below
  // describes for an ordinary delete -- while everything childless is removed
  // outright by purgeUserAccount. Same shape as AdminMessage.authorId, and the
  // read path already renders an anchor stub with no author (audit M34).
  authorId  String?
  postId    String
  parentId  String?
  isHidden  Boolean  @default(false) // admin soft-hide (moderation); matches Post.isHidden / Photo.isHidden
  // Author's own delete. Soft, never a row delete: replies key off parentId,
  // so a hard delete would orphan them (the FK is SetNull, which silently
  // promotes replies to top level) and the thread would lie about its shape.
  // Content is blanked at delete time; the row survives only as structure.
  // Every count and every fetch excludes deleted rows; a deleted parent with
  // surviving replies renders as a "[deleted]" stub.
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  author       User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent       Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies      Comment[]     @relation("CommentReplies")
  commentLikes CommentLike[]

  @@index([postId, createdAt])
  @@index([postId, isHidden])
  // Thread reads walk parentId. Unindexed, opening one comment thread
  // scanned every comment in the database (B-090).
  @@index([parentId])
}

model Like {
  id     String @id @default(cuid())
  userId String
  postId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  // Postgres does not index a foreign key for you, and the unique above
  // leads with userId, so it cannot serve a postId-only predicate. Every
  // feed page, the letters index, saved posts and the 'most liked' sort
  // count likes per post: without this each one scans the whole table
  // (bug audit B-090).
  @@index([postId])
}

model Report {
  id             String   @id @default(cuid())
  reason         String
  reporterId     String
  targetType     String   @default("post") // "post" | "user"
  postId         String?
  reportedUserId String?
  status         String   @default("pending") // "pending" | "reviewed" | "dismissed"
  createdAt      DateTime @default(now())

  reporter     User  @relation("ReportsFiled", fields: [reporterId], references: [id])
  post         Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportsAgainst", fields: [reportedUserId], references: [id], onDelete: Cascade)

  // The conversation the reporter can follow after filing this (see AdminThread).
  // Back-relation only: the foreign key lives on AdminThread.reportId.
  thread AdminThread?

  // One report per (reporter, reported member): a member cannot inflate the
  // flag count against someone by reporting them over and over (audit H5).
  // Post reports carry reportedUserId = NULL, and Postgres treats NULLs as
  // distinct in a unique index, so this constrains only user-to-user reports
  // and leaves post reporting unaffected.
  @@unique([reporterId, reportedUserId])
  // ONE MORE INDEX EXISTS THAT PRISMA CANNOT SEE.
  // `Report_open_post_per_reporter_key` is a PARTIAL unique on
  // (reporterId, postId) WHERE targetType='post' AND status='pending'
  // (prisma/migrations-manual/2026-08-25-report-one-open-per-post.sql). The
  // unique below cannot serve that rule: a post report leaves reportedUserId
  // NULL and Postgres treats NULLs as distinct. Partial indexes have no
  // schema.prisma syntax, so this file is not the whole truth about the table
  // -- and `prisma db push`, already forbidden here, would drop it.
}

/**
 * The audit log (audit H10 / H14 / M36). An append-only record of the events
 * that matter for accountability and breach detection: sign-ins (success and
 * failure), every admin action against a member (block, delete, role change,
 * verification change), a member deleting their own account, and reports.
 *
 * Deliberately has NO foreign keys. actorId and targetId are plain strings, so
 * a row is immutable and OUTLIVES the accounts it names — the entire point of
 * an audit log is that "admin X deleted member Y" survives Y's deletion (and
 * X's). Denormalised context (a name, an email, a method) goes in `detail` for
 * the same reason: it stays readable after the referenced row is gone.
 */
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // who did it; null for an anonymous/system event (e.g. a failed sign-in)
  action     String // dotted verb, e.g. "signin.success", "admin.block", "account.delete"
  targetType String? // "user" | "post" | "report" | ...
  targetId   String?
  ip         String?
  detail     String? // small human-readable context, safe to read after the row it names is gone
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetId])
  @@index([action, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "like" | "comment" | "reply" | "admin" | "admin_note" | "admin_message" | "report_update"
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  // The bell's page walk: newest-first keyset per user. Also what the
  // 100-per-user prune sorts by to find its cutoff.
  @@index([userId, createdAt])
}

// ─── Messages between a member and the admins ────────────────────────────────
// One private conversation per subject, always between exactly one member and
// whichever admin answers. Replaced the third-party Tally feedback form
// (2026-07-24): bug reports, ideas, moderation notes, and the follow-up on
// anything a member reported all land here, so nobody is left wondering what
// happened. Reading or writing a thread is allowed for its own member and for
// admins, and nobody else; every action re-checks that server-side.

model AdminThread {
  id       String  @id @default(cuid())
  memberId String
  // Short line shown in the list. Derived from the first message when the
  // member does not write one, so nothing is ever required of them.
  subject  String?
  // "message" (plain) | "bug" | "idea" | "notice" (an admin started it, e.g. a
  // moderation note) | "report" (follow-up on something the member reported).
  kind     String  @default("message")
  status   String  @default("open") // "open" | "closed"
  // Set when the thread follows a Report the member filed. Unique so one
  // report has at most one conversation. SetNull keeps the conversation alive
  // if the reported post (and with it the report) is deleted.
  reportId String? @unique

  lastMessageAt DateTime @default(now())
  memberUnread  Boolean  @default(false) // unread admin replies waiting for the member
  adminUnread   Boolean  @default(false) // unread member messages waiting for an admin
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member   User           @relation("AdminThreadMember", fields: [memberId], references: [id], onDelete: Cascade)
  report   Report?        @relation(fields: [reportId], references: [id], onDelete: SetNull)
  messages AdminMessage[]

  @@index([memberId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([adminUnread, lastMessageAt])
}

model AdminMessage {
  id       String @id @default(cuid())
  threadId String
  // Null for the lines the app writes itself (e.g. "You reported a post by X"),
  // and for anyone whose account is later deleted.
  authorId String?
  // Which side wrote it. Stored rather than derived from the author's current
  // role, so a member who later becomes an admin does not retro-change history.
  fromAdmin Boolean @default(false)
  body      String
  imageUrl  String? // one optional screenshot (WebP via /api/upload)
  createdAt DateTime @default(now())

  thread AdminThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User?       @relation("AdminMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
}

model PollOption {
  id       String     @id @default(cuid())
  postId   String
  text     String
  position Int

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes PollVote[]
}

model PollVote {
  id           String @id @default(cuid())
  pollOptionId String
  userId       String
  postId       String

  pollOption PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       Post       @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  // Tallying a poll counts by option, and the unique leads with userId (B-090).
  @@index([pollOptionId])
  @@index([postId])
}

model CommentLike {
  id        String @id @default(cuid())
  userId    String
  commentId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

// ─── Places: GeoNames gazetteer for the robust location picker ──────────────

model Place {
  id         Int    @id // geonameid
  name       String
  asciiName  String
  altNames   String? // comma list, for alt-spelling search
  lat        Float
  lng        Float
  country    String // ISO-3166 alpha-2
  admin1     String? // resolved state/province name
  population Int    @default(0)

  userPlaces UserPlace[]

  // NOTE: in the live DB these two are case-insensitive EXPRESSION indexes
  // (lower("asciiName") / lower(name), text_pattern_ops) that power the
  // directory's case-insensitive city search. Prisma cannot express lower() in
  // a schema, so `migrate diff` / `db push` will ALWAYS want to recreate them as
  // plain column indexes. That is a permanent false positive, not real drift.
  // Do NOT let `db push` "fix" it: replacing the lower() indexes with plain ones
  // silently slows directory search. Apply real index changes by hand instead.
  @@index([asciiName])
  @@index([name])
}

// A person's cities: unlimited, ordered, all shown everywhere. label is the
// full display string; city is the short name used for chips, search, and
// Post.cityScope matching. placeId/lat/lng null = free-typed (gazetteer miss).
model UserPlace {
  id        String   @id @default(cuid())
  userId    String
  placeId   Int?
  label     String
  city      String
  lat       Float?
  lng       Float?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place? @relation(fields: [placeId], references: [id])

  // One row per slot per member (audit Low 2). All three writers -- sign-up's
  // register step, the profile's cities pen and the admin's person page, and
  // they share one helper -- are wipe-and-recreate transactions:
  // delete every row, then create the new set at positions 0..n-1. Under READ
  // COMMITTED, an interleaved pair could each delete what they saw and then
  // both insert, leaving the member with two sets of cities, two rows at
  // position 0 and doubled map pins. With this, the loser's transaction aborts
  // on the unique instead, which is the right outcome and also writes the
  // invariant down.
  @@unique([userId, position])
  // Redundant with the leading column of the unique above; kept because the
  // unique is stated as an invariant and this as the access path, and a future
  // reordering of the unique should not silently cost the lookup.
  @@index([userId])
  // Case-insensitive expression index in the DB (lower(city)); see the fuller
  // note on Place above. `migrate diff` will always flag it; do not "fix" it.
  @@index([city])
}

// ─── Catch-ups: the recurring per-group newsletter ───────────────────────────
// Table names are chosen to NOT collide with the dead tables left by the
// reverted build: CatchupEdition (not CatchupIssue) and CatchupPrompt (not
// CatchupQuestion) are genuinely absent, no rename needed. BUT live DB
// introspection (2026-07-05) found the reverted build ALSO left physical
// "Catchup" and "CatchupPref" tables behind with THESE EXACT NAMES, and their
// columns do not match this schema (legacy Catchup has `creatorId`, not
// `createdById`; legacy CatchupPref has `optedOut boolean`, not
// `reminderMode`). Without a rename, `prisma.catchup.*` / `prisma.catchupPref.*`
// would silently read/write the wrong table (some queries "succeed" against
// stale columns, others throw missing-column errors) instead of the intended
// P2021 "table does not exist" pre-migration signal. `@@map` below points
// these two models at fresh physical table names so the section 6.3 migration
// SQL creates genuinely new tables; the Prisma Client property names
// (`prisma.catchup`, `prisma.catchupPref`) are unchanged, so no app code
// outside this file needs to change. See docs/spec/catchups.md section 6.
// The legacy Catchup/CatchupPref/CatchupAnswer/CatchupAnswerLove/CatchupIssue/
// CatchupQuestion tables are left untouched (contain leftover rows from the
// reverted build); dropping them is a separate, optional owner action.

model Catchup {
  id          String    @id @default(cuid())
  groupId     String    @unique
  createdById String?                       // the Keeper; nullable so the Catch-up survives if they leave
  title       String?                       // optional custom name; UI falls back to "{group} Catch-ups"
  intro       String?                       // one-line description on the home
  cadence     String    @default("monthly") // "biweekly" | "monthly" | "quarterly"
  status      String    @default("active")  // "active" | "paused" | "ended"
  // Shareable invite link (/catchups/join/<token>). A BEARER token: whoever
  // holds it can join, which is what a share link is. Not derived from `id`,
  // which is already public in every URL of this Catch-up. Nullable only
  // because the column was added to a live table; every row has one and
  // createCatchup* always writes one.
  inviteToken String?   @unique
  nextOpensAt DateTime?                      // when the next Round auto-opens (recurring cadences)
  // When the Keeper paused. Pausing FREEZES the live Round (the clock, the
  // reminders, the publish), so resume shifts every unreached deadline forward
  // by exactly this long: the group gets back the window it had, rather than
  // finding it silently expired. NULL means "not paused".
  pausedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("CatchupsKept", fields: [createdById], references: [id], onDelete: SetNull)
  editions  CatchupEdition[]
  prefs     CatchupPref[]

  @@index([status, nextOpensAt])
  @@map("CatchupSeries") // see collision note above; legacy "Catchup" table exists with incompatible columns
}

model CatchupEdition {
  id               String    @id @default(cuid())
  catchupId        String
  number           Int
  theme            String?
  status           String    @default("collecting") // draft|collecting|answering|preparing|published
  questionsCloseAt DateTime?
  answersCloseAt   DateTime?
  publishAt        DateTime?                          // = answersCloseAt + 24h (the preparing ritual)
  publishedAt      DateTime?
  // Packed reminder bookkeeping, see `dailyBucket`/`withDailyBucket` in
  // src/lib/catchups.ts. Low byte = flags (4 = auto-extended once; 1 and 2 are
  // the retired two-days/last-day bits, inert on old rows). High bits = the
  // days-left value the last DAILY reminder was sent for, 0 for none.
  remindersSent    Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  catchup Catchup         @relation(fields: [catchupId], references: [id], onDelete: Cascade)
  prompts CatchupPrompt[]
  entries CatchupEntry[]

  @@unique([catchupId, number])
  @@index([status, publishAt])
}

model CatchupPrompt {
  id        String   @id @default(cuid())
  editionId String
  // Nullable and SetNull: a question is answered by everyone, so it cannot die
  // with the person who asked it. Cascade here meant purging one member erased
  // every prompt they had ever written in ANY Catch-up, and each prompt took
  // all thirty answers under it out of a published Round. Null renders as an
  // asker who left, which the anonymous path already draws.
  authorId  String?                         // always stored, even when shown anonymously
  text      String
  category  String?                          // library set id (e.g. "valley-days") or null for custom
  source    String   @default("member")     // "library" | "member" | "keeper"
  showAsker Boolean  @default(true)          // false = submitted anonymously
  accepted  Boolean  @default(false)         // curated into the Round by the Keeper
  position  Int      @default(0)
  createdAt DateTime @default(now())

  edition CatchupEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  author  User?          @relation("CatchupPromptsAuthored", fields: [authorId], references: [id], onDelete: SetNull)
  entries CatchupEntry[]

  @@index([editionId, position])
}

model CatchupEntry {
  id        String   @id @default(cuid())
  editionId String                          // denormalized for fast whole-Round reads
  promptId  String
  authorId  String
  body      String?
  images    String?                          // JSON array of R2 urls (reuse /api/upload)
  songUrl   String?
  songTitle String?
  songArt   String?                          // Spotify oembed thumbnail_url
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edition CatchupEdition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  prompt  CatchupPrompt     @relation(fields: [promptId], references: [id], onDelete: Cascade)
  author  User              @relation("CatchupEntriesAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  loves   CatchupEntryLove[]

  @@unique([promptId, authorId])
  @@index([editionId])
}

model CatchupEntryLove {
  id      String @id @default(cuid())
  userId  String
  entryId String

  user  User         @relation("CatchupLoves", fields: [userId], references: [id], onDelete: Cascade)
  entry CatchupEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
  @@index([entryId])
}

model CatchupPref {
  id           String @id @default(cuid())
  catchupId    String
  userId       String
  reminderMode String @default("all")       // "all" | "last" | "off"
  // One member's own copy of this Catch-up, filed or thrown away. Both are
  // PERSONAL by decision (owner, 2026-08-21): nobody else's view changes, so
  // no member action can destroy something another member relies on. This row
  // is already unique on (catchupId, userId) and cascades from both sides,
  // which is why the state lives here rather than on Catchup or GroupMember --
  // per-member state cannot leak across members by construction.
  archivedAt   DateTime?                    // tucked into "Archived" on /catchups; still a member, still notified
  deletedAt    DateTime?                    // in "Recently deleted"; notifications stop, restorable for 30 days

  catchup Catchup @relation(fields: [catchupId], references: [id], onDelete: Cascade)
  user    User    @relation("CatchupPrefs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([catchupId, userId])
  // The nightly retention sweep's only predicate: find the copies whose 30 days
  // are up. Partial would be tighter, but Prisma cannot express one and the
  // table is one row per (member, Catch-up) they have an opinion about.
  @@index([deletedAt])
  @@map("CatchupReminderPref") // see collision note above; legacy "CatchupPref" table has `optedOut boolean`, not `reminderMode`
}

// ─── Lab: per-room archive state for /lab (2026-07-30) ───────────────────────
// Replaces src/app/lab/archive-overrides.json: a deployed Vercel filesystem is
// read-only, so a file written at request time could never persist the owner's
// archiving on the domain. One row per room whose archived flag differs from
// its registry default (src/app/lab/_registry.ts); no row = default applies.
// Table created by prisma/migrations-manual/2026-07-30-lab-archive.sql (db
// push is blocked, see the Place note above); until it runs, reads fall back
// to the registry defaults via the P2021 guard in src/app/lab/_archive-state.ts.

model LabRoomState {
  href      String   @id // the room's registry href, e.g. "/lab/houses"
  archived  Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt
}

// One row per attempt to chip in on /support, created BEFORE the payer sees
// the Razorpay modal and updated afterwards. Rows in "created" that never move
// are abandoned checkouts, which is normal and worth being able to see.
//
// This table is the reason /support can ever show a real recovered figure
// instead of the hand-edited constant in cost-bar.tsx, and it is what makes
// both confirmation paths (browser callback, webhook) idempotent.
model Contribution {
  id     String  @id @default(cuid())
  // Nullable + SetNull: a deleted account must never take the record of its
  // money with it. Also leaves room for a future signed-out contribution.
  userId String?

  // Paise, always -- the unit Razorpay counts in. Rupees exist only in the UI.
  amount   Int
  currency String @default("INR")
  // "created" | "paid" | "failed" | "refunded" | "disputed".
  // The last two are written only by the webhook when Razorpay says the money
  // went back (audit M58), and only for the WHOLE amount -- a partial refund
  // leaves the row "paid" and is carried by refundedAmount below (audit
  // C-087). Every sum in the app filters on status: "paid", so moving the row
  // out of it is what un-counts a fully returned gift everywhere at once. The
  // row itself is never deleted -- it is the record that money moved and came
  // back. The states a row may become "paid" FROM are in contribution-state.ts;
  // a reversal is terminal.
  status   String @default("created")

  // Real money or a test payment. This database is shared by production AND
  // local dev (see AGENTS.md), and a Razorpay test order is indistinguishable
  // from a live one by its ids alone, so without this column a developer
  // clicking Contribute on localhost would land a row that looks exactly like
  // a real contribution. Derived from the key prefix, never from the client.
  // Anything summing this table for a public figure must filter on it.
  livemode Boolean @default(false)

  // Paise handed back, cumulative. A refund is not always the whole gift --
  // the Razorpay dashboard takes an amount -- and until this column existed
  // ANY refund.processed flipped the whole row to "refunded", so ₹100 returned
  // on a ₹5,000 gift erased the entire ₹5,000 from the recovery bar, from
  // "Given, all time" and from the member's own perk ledger (audit C-087).
  // Every money sum now reads amount MINUS this (see contribution-state.ts),
  // and the row only moves to "refunded" when the whole amount is back.
  refundedAmount Int @default(0)

  // The Razorpay refund and dispute ids already folded into refundedAmount.
  // The webhook is retried on any non-2xx and can be resent by hand from the
  // dashboard, so without this a re-delivered refund.processed would subtract
  // the same paise twice. Postgres array rather than a ledger table because a
  // contribution has at most a handful of these and the `has` check is the
  // whole of the idempotency.
  reversalIds String[] @default([])

  // Unique: this is the idempotency key. The browser callback and the webhook
  // both race to confirm the same order, and only one of them may win.
  razorpayOrderId   String  @unique
  razorpayPaymentId String?
  method            String? // "upi" | "card" | "netbanking" ... as Razorpay reports it
  failureReason     String?

  createdAt DateTime  @default(now())
  paidAt    DateTime?
  updatedAt DateTime  @updatedAt

  user User? @relation("Contributions", fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

// ─── Metric snapshots: the history the vendors will not keep ────────────────
//
// Sentry's free plan drops errors after 30 days. Vercel Analytics keeps 30.
// PostHog keeps a year. None of them will tell you in 2028 what the site
// looked like in 2026, and none of it can be recovered once dropped.
//
// A nightly job (scripts/ops/snapshot.mjs) writes one row per metric per day
// into OUR database, from every source at once. The admin room then reads only
// this table: fast, no API keys at page load, no vendor rate limit, and a
// history that outlives every free tier it was collected from.
//
// Key-value rather than a wide table on purpose. A new metric is a new string,
// not a migration, and this list is certain to grow.
model MetricSnapshot {
  id String @id @default(cuid())

  // The UTC day this describes. Date, not timestamp: two runs on one day must
  // collide and overwrite rather than quietly double-count.
  day    DateTime @db.Date
  // "db" | "sentry" | "posthog" | "github"
  source String
  // Dotted, e.g. "members.total", "letters.published", "errors.unresolved".
  metric String
  // Float, so a count and a conversion rate can share one column.
  value  Float

  capturedAt DateTime @default(now())

  // The idempotency key: re-running today's collection updates today's row.
  @@unique([day, source, metric])
  // The room's read: one metric's line over time.
  @@index([source, metric, day])
}

// ─── Presence and sessions: who is here, where, on what ─────────────────────
//
// The owner asked for this explicitly (2026-08-19): "who's online right now,
// where they are, what device, what page... how long is the average session".
// The stated purpose is finding where older alumni get stuck, and it is
// disclosed in the site's policies.
//
// WHY A TABLE rather than more columns on User: a column can only hold the
// LAST value, which answers "where is Ravi now" and nothing else. Session
// length, pages per visit, and "how often does someone come back" are all
// questions about a span of time, and a span needs a row.
//
// A Visit is a span of activity with no gap longer than SESSION_GAP_MIN
// (src/lib/last-seen.ts). Cross that gap and the next page view opens a new
// Visit, which is the standard definition and the one that makes "average
// session" mean what a person expects it to mean.
model Visit {
  id     String @id @default(cuid())
  userId String

  startedAt DateTime @default(now())
  // Last activity in this visit. The visit's length is endedAt - startedAt,
  // so a single-page visit is legitimately zero rather than a guess.
  endedAt   DateTime @default(now())
  views     Int      @default(1)

  // Where they were when it ended. Kept on the visit rather than per view:
  // a per-view table is a firehose that answers little more, and PostHog
  // already holds the full path-by-path journey.
  lastPath String?
  // The FIRST page of the visit. The pair (entryPath, lastPath) is the cheap
  // version of a journey: where people come in and where they stop.
  entryPath String?
  // Where they came from, host only. The full URL would carry query strings
  // (search terms, tracking ids) belonging to somebody else's site.
  referrer String?

  // Parsed from the user agent, coarse on purpose. "phone | tablet | desktop"
  // is what answers "are the older alumni on phones"; the exact model is not
  // a question anyone has.
  device  String?
  os      String?
  browser String?
  // Browser UI language, e.g. "en-GB". The one honest signal about whether
  // anyone needs this site in another language.
  language String?

  // From Vercel's edge headers, which cost nothing -- they are on every
  // request already. Absent in local development, so all are nullable.
  country  String?
  city     String?
  region   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "Who is online right now" and "recent visits", the two live reads.
  @@index([endedAt])
  // One person's history, and the lookup that decides whether to extend the
  // current visit or open a new one.
  @@index([userId, endedAt])
}

// ─── What people look for ───────────────────────────────────────────────────
//
// The owner asked for "the most common searches" in the session that
// commissioned the analytics room, and nothing recorded them: the header pill
// submits to /feed?q= and the directory filters in the browser, so every query
// anyone has ever typed was thrown away.
//
// The query text is stored as typed. That is the entire point -- "what are
// people failing to find" cannot be answered by a count -- and it is covered
// by the same disclosure as the rest of the presence data.
model SearchLog {
  id     String  @id @default(cuid())
  userId String?

  // "feed" | "directory" | "people" | "places"
  scope String
  query String
  // How many rows came back. A query with zero results is the useful one: it
  // is somebody looking for a person or a place this site could not show them.
  results Int?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // "What is searched most", and the zero-result list.
  @@index([scope, createdAt])
  // The retention sweep's predicate. The composite above leads on `scope`, so
  // it cannot serve a bare `createdAt < cutoff` (bug audit B-093).
  @@index([createdAt])
}

// ─── Who looks at what, and how often ───────────────────────────────────────
//
// The owner asked for two things this answers at once: the curiosity ("who
// searches for whose profile, how often") and the product question ("read
// click-through rates" -- does anything written actually get read).
//
// A COUNTER, not a log, and that choice is load-bearing. A row per view is
// unbounded: 2,000 members at twenty views a day is 14M rows a year, which is
// gigabytes on a 500MB plan. Keyed on (viewer, kind, target) it is bounded by
// distinct PAIRS instead -- a member might look at fifty profiles ever, so
// 2,000 members is ~100k rows total, and it answers "how often does A look at
// B" better than a log does, because the answer is one column rather than a
// count over a scan.
//
// firstAt/lastAt keep what the counter would otherwise lose: whether an
// interest is old or current.
model ContentView {
  id String @id @default(cuid())

  viewerId String
  // "profile" | "letter" | "post" | "photo" | "round"
  kind     String
  // The profile's user id, the letter's post id, and so on. Not a foreign key:
  // one column cannot reference five tables, and a view of something later
  // deleted is still a true fact about what someone was interested in.
  targetId String

  count   Int      @default(1)
  firstAt DateTime @default(now())
  lastAt  DateTime @default(now())

  viewer User @relation("ContentViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  // The upsert key.
  @@unique([viewerId, kind, targetId])
  // "Who is looking at this", and the most-viewed lists.
  @@index([kind, targetId])
  // "What has this person been looking at", and recency.
  @@index([viewerId, lastAt])
}

// ─── Who could not get in ───────────────────────────────────────────────────
//
// The owner's reason for the analytics room is finding where older alumni get
// stuck, and somebody who cannot sign in AT ALL is the strongest possible
// version of that -- and was completely invisible, because a failed login left
// no trace anywhere. They simply never appeared in any number.
//
// Never stores a password or any part of one. The email is stored as typed,
// because "which address did they keep trying" is the whole point: a member
// entering the wrong address is a different problem from one entering the
// wrong password, and only the address distinguishes them.
model LoginAttempt {
  id String @id @default(cuid())

  // Lowercased as submitted. May belong to no account at all, which is itself
  // one of the more common failures.
  email  String
  // Set when the address matched an account, so a decade can be attached.
  userId String?

  ok Boolean
  // "ok" | "no-account" | "no-password-set" | "wrong-password"
  reason String

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email, createdAt])
  @@index([userId, createdAt])
}

// ─── The office roster ───────────────────────────────────────────────────────
//
// The school's registration sheets, consolidated (owner, 2026-08-19: the
// Centenary registrations plus the old rishivalley.xls Master list), so a
// signup that matches them verifies itself with verifyMethod "office_list"
// and the owner can see it was the sheets that vouched, not him. Written only
// by scripts/dev/import-roster.mjs; read only by src/lib/roster.ts.
//
// Deliberately carries NOTHING beyond what matching needs -- no addresses, no
// phones, no admission numbers -- because a roster row is somebody who never
// signed up, and holding their data beyond name/email/batch is liability with
// no function. Auto-fill from the sheets is explicitly off (owner call).
model RosterEntry {
  id             String  @id @default(cuid())
  fullName       String  // as printed on the sheet, initials stripped
  normalizedName String  // lowercased, diacritics and punctuation collapsed (roster-rule.ts)
  email          String? // lowercased; most Master rows have none
  batchYear      Int?    // "Batch" / "Year of Passing" as the sheet stated it
  source         String  // "centenary-2026" | "master" | "phase3-probe"
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([normalizedName, batchYear])
}

// ─── Stored images still owed a delete ───────────────────────────────────────
//
// A purge cannot delete R2 objects and database rows atomically: the rows have
// to go first (a member is not erased until their rows are), and the rows are
// the only thing that remembers where their images live. Before this table the
// gap was fatal -- one flaky R2 minute during a purge left bytes publicly
// fetchable at their pub-*.r2.dev URLs with nothing left anywhere able to
// enumerate them, and the audit line still said they had been removed.
//
// So the worklist is written INSIDE the same transaction as the row delete.
// Whatever the loop afterwards fails to remove stays here, with the error that
// stopped it, and the nightly retention sweep tries again. A row's presence
// means "these bytes are still out there"; its absence means they are gone.
model PendingImagePurge {
  id        String   @id @default(cuid())
  url       String
  // Why it was queued, so a backlog can be read without archaeology:
  // "purge" (an account erased) or "retention" (the nightly sweep aged an
  // AdminMessage out and its screenshot went with it -- audit C-065).
  reason    String   @default("purge")
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── One drain at a time ─────────────────────────────────────────────────────
//
// Every authenticated page view runs `after(drainMailQueue)` and every enqueue
// schedules one, so at launch a hundred overlapping passes would each send a
// different row in parallel -- a self-inflicted 429 storm against a provider
// that rate-limits to roughly two requests a second, and a budget check that
// several passes can pass simultaneously (bug audit B-072).
//
// A lease row rather than a Postgres advisory lock: advisory locks are
// session-scoped and this app talks to Postgres through the pgbouncer
// transaction pooler, where a session is whatever connection the pooler
// happens to hand out next. A conditional updateMany on an expiry is the same
// optimistic claim the queue already uses per row, and it survives a process
// dying mid-pass: the lease simply expires.
model QueueLease {
  /** The named piece of work, e.g. "mail-drain". One row per queue. */
  name      String   @id
  /** Random per pass, so a release can only release its own lease. */
  holder    String
  expiresAt DateTime
}
