    "visual": "playwright test -c e2e/playwright.config.ts --project=desktop --project=mobile visual.spec.ts",
    "visual:update": "playwright test -c e2e/playwright.config.ts --project=desktop --project=mobile visual.spec.ts --update-snapshots",
    "visual:report": "playwright show-report e2e/.report",
