                "photoUrl": null,
                "birdOverride": "spotted-owlet"
              },
              "text": "And why that one?",
              "category": null,
              "kind": "text",
              "source": "member",
              "choices": [],
              "showAsker": true,
              "accepted": true,
              "position": 1,
              "createdAt": "2026-08-01T09:00:00.000Z",
              "answers": [
                {
                  "id": "ans-376",
                  "author": {
                    "id": "mx-ravi-menon-1975",
                    "name": "Ravi Menon",
                    "batchYear": 1975,
                    "photoUrl": null,
                    "birdOverride": "spotted-owlet"
                  },
                  "body": "It was the sound, that particular quiet the valley has at four in the afternoon before the birds start up again. I stood by the tamarind for a while feeling ridiculous about it. Nobody warned me that the dining hall.",
                  "images": [],
                  "songUrl": null,
                  "songTitle": null,
                  "songArt": null,
                  "audio": null,
                  "pollOptionId": null,
                  "hearts": [],
                  "createdAt": "2026-08-10T10:40:00.000Z",
